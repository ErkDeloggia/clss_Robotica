<?xml version="1.0" encoding="utf-8"?>
<!--Aqui comienza el robot-->
<robot name="roarm" xmlns:xacro="http://ros.org/wiki/xacro" >

    <robot name="roarm">

<link name="world">
    </link>

    <joint name="world_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="grey">
                <color rgba="0.1 0.1 0.1 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/base.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0281 -0.0095 0.0343" rpy="0 0 0"/>
            <mass value="0.4014"/>
            <inertia ixx="0.0005189" ixy="-0.00000146" ixz="0.00000293" 
                iyy="0.0004811" iyz="0.00001726" izz="0.0002832"/>
        </inertial>
    </link>

    <link name="roarm_cintura">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/cintura.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="red">
                <color rgba="1 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/cintura.stl" xyz="0.0 0.0 0.0"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.005962 0.001535 -0.011627" rpy="0 0 0"/>
            <mass value="0.214"/>
            <inertia ixx="0.00016595" ixy="0.00000036" ixz="-0.00000003" 
                iyy="0.00006800" iyz="0.00000006" izz="0.00013722"/>
        </inertial>
    </link>

    <joint name="base_to_cintura" type="revolute">
        <parent link="base_link" />
        <child link="roarm_cintura" />
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" velocity="50.0" 
               effort="1000.0"/>
        <origin xyz="0.039 -0.0148 0.085" rpy="0 0 0"/>
         <dynamics damping="1.5" friction="1.0"/>
    </joint>

    <link name="roarm_antebrazo">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/antebrazo.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="green">
                <color rgba="0.0 1.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/antebrazo.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.000755 -0.000001 0.103638" rpy="0 0 0"/>
            <mass value="0.448"/>
            <inertia ixx="0.00220396" ixy="-0.00000012" ixz="0.00003657" 
                     iyy="0.00211515" iyz="-0.00000007" 
                     izz="0.00014311"/>
        </inertial>
    </link>

    <joint name="cintura_to_antebrazo" type="revolute">
        <parent link="roarm_cintura" />
    <child link="roarm_antebrazo" />
        <axis xyz="0 1 0"/>
        <limit lower="-5" upper="2.2" velocity="50.0" 
               effort="1000.0"/>
        <origin xyz="-0.009 0.00136 0.014135" rpy="0 0 0"/>
        <dynamics damping="2.5" friction="1.5"/>
    </joint>

    <link name="roarm_brazo">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/brazo.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/brazo.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0354 0.0 0.0520" rpy="0 0 0"/>
            <mass value="0.230"/>
            <inertia ixx="0.000785" ixy="-0.00000002" ixz="-0.0000184" 
                     iyy="0.000758" iyz="0.00000005" 
                     izz="0.0000652"/>
        </inertial>
    </link>

    <joint name="antebrazo_to_brazo" type="revolute">
        <parent link="roarm_antebrazo" />
        <child link="roarm_brazo" />
        <axis xyz="0 1 0"/>
        <limit lower="-4.5" upper="1.5" velocity="50.0" 
               effort="1000.0"/>
        <origin xyz="-0.01 0.0 0.21" rpy="0 0 0"/>
         <dynamics damping="2.0" friction="1.0"/>
    </joint>

    <link name="roarm_gripper">
        <visual>
        <origin xyz="0.6 -0.65 0.0 " rpy="0 3.14159 0" />
            <geometry>
                <mesh filename="package://roarm_description/meshes/gripper.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="brazo_to_gripper" type="fixed">
        <parent link="roarm_brazo" />
        <child link="roarm_gripper" />
        <origin xyz="0.2 0.0 0.0 " rpy="0 0 0"/>
    </joint>




</robot>