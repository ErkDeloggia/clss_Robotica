<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">

  <!-- Controlador para la Cintura -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_to_cintura</joint_name>
      <p_gain>200.0</p_gain>
      <d_gain>65.0</d_gain>
      <i_gain>0.01</i_gain>
      <i_max>1.0</i_max>
      <i_min>-1.0</i_min>
    </plugin>
  </gazebo>

  <!-- Controlador para el Antebrazo -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>cintura_to_antebrazo</joint_name>
      <p_gain>100.0</p_gain>
      <d_gain>30.0</d_gain>
      <i_gain>0.01</i_gain>
      <i_max>1.0</i_max>
      <i_min>-1.0</i_min>
    </plugin>
  </gazebo>

  <!-- Controlador para el Brazo -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>antebrazo_to_brazo</joint_name>
      <p_gain>100.0</p_gain>
      <d_gain>30.0</d_gain>
      <i_gain>0.01</i_gain>
      <i_max>1.0</i_max>
      <i_min>-1.0</i_min>
    </plugin>
  </gazebo>


  <!-- Plugin para publicar el estado de todas las articulaciones en Gazebo -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>base_to_cintura</joint_name>
      <joint_name>cintura_to_antebrazo</joint_name>
      <joint_name>antebrazo_to_brazo</joint_name>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

</robot>